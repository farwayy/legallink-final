# Copy this file to .env and fill in your own values.
# On Render (or any host), add the same names under Environment instead.
# NEVER commit the real .env file.

PORT=5000
# Local: mongodb://localhost:27017/legallink   Online: your MongoDB Atlas mongodb+srv://... string
MONGODB_URI=
# Long random value. Create one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Address of the frontend (local: http://localhost:3000, online: your Vercel address)
CLIENT_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8001

# Mizan (legal AI)
GOOGLE_GEMINI_API_KEY=

# Emails (Gmail address + Gmail app password)
EMAIL_USER=
EMAIL_PASS=

# Google reCAPTCHA (secret key)
RECAPTCHA_SECRET_KEY=

# Dialogflow: either point to the key file...
DIALOGFLOW_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=dialogflow-key.json
# ...or, on hosting, paste these two values from the key file instead of uploading it
DIALOGFLOW_CLIENT_EMAIL=
DIALOGFLOW_PRIVATE_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (sk_test_... while testing, sk_live_... when live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
